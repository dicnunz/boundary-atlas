{
  "name": "@boundary-atlas/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @boundary-atlas/core && npm run build -w boundary-atlas && npm run build -w @boundary-atlas/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @boundary-atlas/core && npm run build -w @boundary-atlas/core && npm run typecheck -w boundary-atlas && npm run typecheck -w @boundary-atlas/web",
    "test": "vitest run",
    "e2e": "playwright test",
    "demo:fixtures": "tsx scripts/demo-fixtures.ts",
    "demo:self": "tsx scripts/demo-self.ts",
    "preview:web": "npm run preview -w @boundary-atlas/web -- --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
